      "css": ":host{--paper:#f4f6fb;--card:#fff;--ink:#0f2440;--body:#26364a;--soft:#4a5868;--navy:#1f4670;--deep:#0f2440;--on-dark:#f4f7fb;--on-dark-soft:#c9d7ea;--amber:#f2a65a;--amber-2:#f6bd80;--field:#e6ecf5;--focus:#1f4670;--error:#b3261e} .ds-night{background-color:var(--deep);background-image:repeating-linear-gradient(135deg,transparent 0 22px,rgba(255,255,255,.035) 22px 23px);padding:24px} .ds-type{display:flex;align-items:center;gap:16px;min-height:80px;padding:14px 16px 14px 18px;border-radius:20px;background:rgba(255,255,255,.07);color:var(--on-dark);text-decoration:none;font-family:'Cal Sans','Avenir Next','Segoe UI',system-ui,sans-serif;font-weight:400;font-size:24px;line-height:1.15} .ds-type svg:first-child{color:var(--on-dark-soft);flex:none} .ds-name{flex:1} .ds-arrow{width:44px;height:44px;border-radius:50%;display:grid;place-items:center;background:rgba(255,255,255,.12);transition:background-color .2s,color .2s} .ds-type:hover .ds-arrow,.ds-type:focus-visible .ds-arrow{background:var(--amber);color:var(--ink)} .ds-type:focus-visible{outline:none} .ds-type:focus-visible .ds-arrow{outline:3px solid var(--amber);outline-offset:3px}"
