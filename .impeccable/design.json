      "css": ":host{--paper:#f4f6fb;--card:#fff;--ink:#0f2440;--body:#26364a;--soft:#4a5868;--navy:#1f4670;--deep:#0f2440;--on-dark:#f4f7fb;--on-dark-soft:#c9d7ea;--amber:#f2a65a;--amber-2:#f6bd80;--field:#e6ecf5;--focus:#1f4670;--error:#b3261e} .ds-steps{list-style:none;margin:0;padding:0;display:grid;gap:22px;counter-reset:s;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI','Helvetica Neue',Arial,sans-serif;font-size:18px;line-height:1.6} .ds-steps li{display:grid;grid-template-columns:48px 1fr;column-gap:16px;counter-increment:s} .ds-steps li::before{content:counter(s);grid-row:1/3;width:48px;height:48px;border-radius:50%;display:grid;place-items:center;background:var(--amber);color:var(--ink);font-family:'Cal Sans','Avenir Next','Segoe UI',system-ui,sans-serif;font-weight:400;font-size:20px;line-height:1} .ds-steps b{font-family:'Cal Sans','Avenir Next','Segoe UI',system-ui,sans-serif;font-weight:400;font-size:24px;line-height:1.2;color:var(--ink);margin-top:4px} .ds-steps span{color:var(--soft)}"
